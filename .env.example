# ─── Credenciales Telegram ────────────────────────────────────────────────────
# Obtené tu API_ID y API_HASH en: https://my.telegram.org/apps
API_ID=12345678
API_HASH=abcdef1234567890abcdef1234567890

# Nombre del archivo de sesión (se guarda como <SESSION_NAME>.session)
SESSION_NAME=telegram_forwarder

# (Opcional) Si tenés un session string generado con gen_session.py,
# pegalo acá y el script NO pedirá autenticación interactiva.
# SESSION_STRING=

# Token de bot de Telegram (@BotFather) para despachar los mensajes
BOT_TOKEN=123456789:ABCdefGHIjklMNOpqrsTUVwxyz
